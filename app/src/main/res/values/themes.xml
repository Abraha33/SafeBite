<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material Design 3 para pantallas XML (auth) y compatibilidad con Compose. -->
    <style name="Theme.SafeBite" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <!-- Avatar circular con ShapeableImageView -->
    <style name="ShapeAppearanceOverlay.Avatar.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Pantalla de arranque con layout personalizado -->
    <style name="Theme.SafeBite.Splash" parent="Theme.SafeBite">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>
</resources>