rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    //  Colección: users/{userId}
    //  Cada documento se identifica por el UID del
    //  usuario. Solo su propietario puede leerlo o
    //  modificarlo.
    // ──────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────
    //  Colección: sightings/{document}
    //  Muro comunitario de avistamientos.
    //  - Lectura: cualquier usuario autenticado.
    //  - Crear: cualquier usuario autenticado. El
    //    documento debe incluir un campo creatorUid
    //    con el UID del creador.
    //  - Actualizar / Eliminar: solo el creador
    //    (request.auth.uid == resource.data.creatorUid).
    // ──────────────────────────────────────────────
    match /sightings/{document} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.creatorUid
                     == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.creatorUid
                             == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    //  Colección: product_scans/{scanId}
    //  Historial privado de escaneos.
    //  Cada documento lleva un campo "uid" que
    //  referencia al propietario.
    // ──────────────────────────────────────────────
    match /product_scans/{scanId} {
      allow read, write: if request.auth != null
                         && request.auth.uid
                         == resource.data.uid;
      allow create: if request.auth != null
                    && request.auth.uid
                    == request.resource.data.uid;
    }
  }
}
